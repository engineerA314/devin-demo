# Browser-facing API URL baked into the web application.
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# These defaults match `make superset`. Clear any value to use preview mode.
# The internal URL is reachable from the controller container; the public URL
# is used by the browser iframe.
SUPERSET_INTERNAL_URL=http://host.docker.internal:9001
SUPERSET_PUBLIC_URL=http://localhost:9001
SUPERSET_DASHBOARD_ID=00000000-0000-4000-8000-000000000001
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin

# Added in the incident automation phase. Never commit real values.
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_TRIAGE_AUTOMATION_ID=
DEVIN_TRIAGE_WEBHOOK_URL=
DEVIN_TRIAGE_WEBHOOK_SECRET=
DEVIN_REMEDIATION_AUTOMATION_ID=
DEVIN_TRIAGE_MAX_ACU=20
DEVIN_REMEDIATION_MAX_ACU=40

# Recommended for fast artifact reconciliation and required for private forks.
# Devin still creates issues and pull requests through its own GitHub connection.
GITHUB_TOKEN=
GITHUB_REPOSITORY=engineerA314/superset
GITHUB_WEBHOOK_SECRET=
GITHUB_MANAGED_LABEL=autopilot-managed
INCIDENT_DB_PATH=.state/incidents.db
WORKFLOW_RECONCILE_SECONDS=20
