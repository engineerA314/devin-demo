# Browser-facing API URL baked into the web application.
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Optional for the incident-to-PR workflow. Set these after `make superset` to
# show a real Embedded SDK dashboard on the separate customer analytics page.
# Without them, that page shows a connection-required state, not fake charts.
SUPERSET_INTERNAL_URL=
SUPERSET_PUBLIC_URL=
SUPERSET_DASHBOARD_ID=
SUPERSET_USERNAME=
SUPERSET_PASSWORD=

# Required. Docker Compose refuses to start without these values.
# Use a Devin service user with ManageOrgSessions and ViewOrgSessions.
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_TRIAGE_MAX_ACU=20
DEVIN_REMEDIATION_MAX_ACU=40
# Bound the automated fix-check-fix loop before handing the PR to an engineer.
CI_FEEDBACK_MAX_ATTEMPTS=2
ATTRIBUTION_MIN_CONFIDENCE=0.75

# Both repositories must be accessible to the controller and connected to Devin.
# The Superset fork must be writable through Devin's GitHub connection.
GITHUB_REPOSITORY=
PRODUCT_REPOSITORY=
# Optional when both repositories are public. Required if either is private;
# also changes polling from 120 seconds to 20 seconds.
GITHUB_TOKEN=
# Optional. Empty selects polling mode, so a public callback URL is unnecessary.
GITHUB_WEBHOOK_SECRET=
GITHUB_MANAGED_LABEL=autopilot-managed
WORKFLOW_RECONCILE_SECONDS=20
