# Browser-facing API URL baked into the web application.
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Leave these blank for the zero-setup customer dashboard preview. Fill them
# with the values below only after running `make superset` with a local fork.
SUPERSET_INTERNAL_URL=
SUPERSET_PUBLIC_URL=
SUPERSET_DASHBOARD_ID=
SUPERSET_USERNAME=
SUPERSET_PASSWORD=

# Required for live dispatch. Never commit real values.
DEVIN_API_KEY=
DEVIN_ORG_ID=
DEVIN_TRIAGE_MAX_ACU=20
DEVIN_REMEDIATION_MAX_ACU=40

# Recommended for fast artifact reconciliation and required for private forks.
# Devin still creates issues and pull requests through its own GitHub connection.
GITHUB_REPOSITORY=engineerA314/superset
# Optional for this public fork. Recommended for 20-second reconciliation and
# required when GITHUB_REPOSITORY points to a private fork.
GITHUB_TOKEN=
# Optional. Empty selects polling mode, so a public callback URL is unnecessary.
GITHUB_WEBHOOK_SECRET=
GITHUB_MANAGED_LABEL=autopilot-managed
WORKFLOW_RECONCILE_SECONDS=20
