# Browser-facing API URL baked into the web application.
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Leave these blank to run the polished local preview without Superset.
# For Docker Compose, the internal URL must be reachable from the controller
# container. The public URL must be reachable from the user's browser.
SUPERSET_INTERNAL_URL=http://host.docker.internal:8088
SUPERSET_PUBLIC_URL=http://localhost:8088
SUPERSET_DASHBOARD_ID=
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=

# Added in the incident automation phase. Never commit real values.
DEVIN_API_KEY=
DEVIN_ORG_ID=
GITHUB_TOKEN=
GITHUB_REPOSITORY=engineerA314/superset
